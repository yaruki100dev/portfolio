---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { projectDefinitions } from "../data/site";
import { formatMessage, getLocalizedPath, getTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="projects" class="section shell" aria-labelledby="projects-title">
  <SectionHeading index="03" title={t.projects.section} description={t.projects.description} />
  <h2 id="projects-title" class="display-title reveal">{t.projects.titleTop}<br /><span>{t.projects.titleBottom}</span></h2>
  <div class="projects-grid">
    {projectDefinitions.map((project, index) => {
      const content = t.projects.items[project.key];
      return (
      <article class:list={["project-card", `project-card--${project.accent}`, "reveal"]}>
        <div class="project-index">0{index + 1}</div>
        <div class="project-card__head">
          <p>{content.eyebrow}</p>
          {project.status && <span class="status"><i></i>{t.projects.status[project.status]}</span>}
        </div>
        <h3>{project.name}</h3>
        <p class="project-description">{content.description}</p>
        <div class="project-problem">
          <span>{t.projects.needLabel}</span>
          <p>{content.problem}</p>
        </div>
        <ul class="tag-list" aria-label={formatMessage(t.projects.technologiesLabel, { project: project.name })}>
          {project.technologies.map((technology) => <li>{t.technologies[technology]}</li>)}
        </ul>
        {project.links.length > 0 && (
          <div class="project-links">
            {project.links.map((link) => (
              <a href={link.kind === "external" ? link.href : getLocalizedPath(locale, link.path)} target={link.kind === "external" ? "_blank" : undefined} rel={link.kind === "external" ? "noopener noreferrer" : undefined}>
                {t.projects.links[link.label]}<Icon name={link.kind === "external" ? "external" : "arrow"} size={16} />
              </a>
            ))}
          </div>
        )}
      </article>
    )})}
  </div>
</section>

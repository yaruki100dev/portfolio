---
import Icon from "./Icon.astro";
import { navigationDefinitions, siteConfig } from "../data/site";
import { getLocalizedPath, getTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/types";

interface Props {
  locale: Locale;
  route: string;
}

const { locale, route } = Astro.props;
const t = getTranslations(locale);
const homePath = getLocalizedPath(locale);
const languageLinks = [
  { locale: "en" as const, label: "EN", name: "English", href: getLocalizedPath("en", route) },
  { locale: "es" as const, label: "ES", name: "Español", href: getLocalizedPath("es", route) },
];
---

<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="monogram" href={homePath} aria-label={t.common.homeLabel}>
      <span>{siteConfig.initials}</span><i aria-hidden="true"></i>
    </a>

    <nav class="desktop-nav" aria-label={t.common.primaryNavigation}>
      {navigationDefinitions.map((item) => (
        <a href={`${homePath}#${item.section}`}>{t.navigation[item.key]}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="contact-link" href={`${homePath}#contact`}>{t.common.contact} <Icon name="arrow" size={16} /></a>
      <nav class="language-switcher" aria-label={t.common.languageNavigation}>
        {languageLinks.map((item, index) => (
          <>
            {index > 0 && <span aria-hidden="true">/</span>}
            <a
              href={item.href}
              lang={item.locale}
              hreflang={item.locale}
              aria-label={item.name}
              aria-current={locale === item.locale ? "page" : undefined}
              data-language-link
            >
              {item.label}
            </a>
          </>
        ))}
      </nav>
      <button
        class="icon-button theme-toggle"
        type="button"
        aria-label={t.common.lightTheme}
        aria-pressed="true"
        data-theme-toggle
        data-light-label={t.common.lightTheme}
        data-dark-label={t.common.darkTheme}
      >
        <span class="theme-icon theme-icon--moon"><Icon name="moon" size={18} /></span>
        <span class="theme-icon theme-icon--sun"><Icon name="sun" size={18} /></span>
      </button>
      <button
        class="icon-button menu-toggle"
        type="button"
        aria-label={t.common.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
        data-open-label={t.common.openMenu}
        data-close-label={t.common.closeMenu}
      >
        <span class="menu-icon menu-icon--open"><Icon name="menu" /></span>
        <span class="menu-icon menu-icon--close"><Icon name="close" /></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-nav" aria-label={t.common.mobileNavigation} data-mobile-menu hidden>
    <div class="shell">
      {navigationDefinitions.map((item, index) => (
        <a href={`${homePath}#${item.section}`} data-mobile-link>
          <span>0{index + 1}</span>{t.navigation[item.key]}
        </a>
      ))}
      <a href={`${homePath}#contact`} data-mobile-link><span>05</span>{t.common.contact}</a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  const closeMenu = () => {
    if (!menuButton || !mobileMenu) return;
    menuButton.setAttribute("aria-expanded", "false");
    menuButton.setAttribute("aria-label", menuButton.dataset.openLabel ?? "Open menu");
    mobileMenu.hidden = true;
    document.body.classList.remove("menu-open");
  };

  menuButton?.addEventListener("click", () => {
    if (!mobileMenu) return;
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", String(!isOpen));
    menuButton.setAttribute(
      "aria-label",
      isOpen ? (menuButton.dataset.openLabel ?? "Open menu") : (menuButton.dataset.closeLabel ?? "Close menu"),
    );
    mobileMenu.hidden = isOpen;
    document.body.classList.toggle("menu-open", !isOpen);
  });

  document.querySelectorAll("[data-mobile-link]").forEach((link) => link.addEventListener("click", closeMenu));
  window.addEventListener("resize", () => { if (window.innerWidth >= 900) closeMenu(); });
  window.addEventListener("scroll", () => header?.classList.toggle("is-scrolled", window.scrollY > 12), { passive: true });

  document.querySelectorAll<HTMLAnchorElement>("[data-language-link]").forEach((link) => {
    link.addEventListener("click", () => {
      if (window.location.hash) link.hash = window.location.hash;
    });
  });

  const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const updateThemeButton = (theme: "dark" | "light") => {
    if (!themeButton) return;
    const dark = theme === "dark";
    themeButton.setAttribute("aria-pressed", String(dark));
    themeButton.setAttribute(
      "aria-label",
      dark ? (themeButton.dataset.lightLabel ?? "Switch to light theme") : (themeButton.dataset.darkLabel ?? "Switch to dark theme"),
    );
  };
  updateThemeButton(document.documentElement.dataset.theme === "light" ? "light" : "dark");

  themeButton?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
    updateThemeButton(next);
  });
</script>

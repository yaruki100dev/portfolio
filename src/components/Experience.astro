---
import SectionHeading from "./SectionHeading.astro";
import { getTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/types";

interface Props {
  locale: Locale;
}

const t = getTranslations(Astro.props.locale);
const experiences = [t.experience];
---

<section id="experience" class="section section--surface" aria-labelledby="experience-title">
  <div class="shell">
    <SectionHeading index="02" title={t.experience.section} description={t.experience.description} />
    <h2 id="experience-title" class="sr-only">{t.experience.accessibleTitle}</h2>
    <div class="timeline">
      {experiences.map((experience) => (
        <article class="timeline-item reveal">
          <div class="timeline-rail" aria-hidden="true"><span></span></div>
          <p class="timeline-period">{experience.period}</p>
          <div class="timeline-content">
            <p class="timeline-sector">{experience.sector}</p>
            <h3>{experience.role}</h3>
            <p>{experience.summary}</p>
            <ul>
              {experience.focus.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

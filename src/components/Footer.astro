---
import Icon from "./Icon.astro";
import { siteConfig } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <p>© {year} {siteConfig.name}</p>
    <p class="footer-build">Diseñado con intención. Construido con Astro.</p>
    <div class="footer-socials">
      {siteConfig.social.map((social) => (
        <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`${social.label} de ${siteConfig.name}`}>
          <Icon name={social.icon} size={18} /><span>{social.label}</span>
        </a>
      ))}
    </div>
  </div>
</footer>

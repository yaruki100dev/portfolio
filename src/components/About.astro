---
import SectionHeading from "./SectionHeading.astro";
import { getTranslations } from "../i18n/utils";
import type { Locale } from "../i18n/types";

interface Props {
  locale: Locale;
}

const t = getTranslations(Astro.props.locale);
---

<section id="about" class="section shell" aria-labelledby="about-title">
  <SectionHeading index="01" title={t.about.section} />
  <div class="about-grid">
    <h2 id="about-title" class="display-title reveal">{t.about.titleTop}<br /><span>{t.about.titleBottom}</span></h2>
    <div class="about-copy reveal">
      {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <dl class="about-facts">
        {t.about.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
      </dl>
    </div>
  </div>
</section>

---
import type { SocialKey } from "../data/types";

interface Props {
  name: SocialKey;
  size?: number;
  label?: string;
}

const { name, size = 18, label } = Astro.props;
// Original brand assets and provenance: docs/brand-assets.md.
const assets = {
  github: {
    light: "/brands/github-invertocat-black.svg",
    dark: "/brands/github-invertocat-white.svg",
    width: 98,
    height: 96,
  },
  linkedin: {
    light: "/brands/linkedin-in-black.png",
    dark: "/brands/linkedin-in-white.png",
    width: 840,
    height: 779,
  },
} as const;
const asset = assets[name];
---

<span
  class="brand-icon"
  style={`width: ${size * asset.width / asset.height}px; height: ${size}px`}
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
>
  <img class="brand-icon__light" src={asset.light} width={asset.width} height={asset.height} alt="" draggable="false" />
  <img class="brand-icon__dark" src={asset.dark} width={asset.width} height={asset.height} alt="" draggable="false" />
</span>

<style>
  .brand-icon {
    display: inline-flex;
    flex: 0 0 auto;
    vertical-align: middle;
  }

  .brand-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand-icon__light {
    display: block;
  }

  .brand-icon__dark {
    display: none;
  }

  :global(html[data-theme="dark"]) .brand-icon__light {
    display: none;
  }

  :global(html[data-theme="dark"]) .brand-icon__dark {
    display: block;
  }
</style>
